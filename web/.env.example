# Server-only native API origin; enable --enable-api-v2 on the C++ server.
RYO_API_URL=http://127.0.0.1:8081
# Avoid build/development telemetry.
NEXT_TELEMETRY_DISABLED=1

# Optional trusted local daemon origin for sync status. Never exposed to browsers.
# RYO_DAEMON_RPC_URL=http://127.0.0.1:12211
# Optional absolute path to this same daemon's log, readable by the web server.
# Reads only the last 64 KiB; exposes recognized sync failures without peer data.
# RYO_DAEMON_LOG_PATH=/var/log/ryo/ryod.log
# Required with log path: the UTC offset used by the daemon's log timestamps.
# RYO_DAEMON_LOG_UTC_OFFSET=+00:00
